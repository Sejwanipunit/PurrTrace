# PawTrace — environment variables
# Copy this file to ".env" and fill in your Supabase project values.
# Without these, the app runs in DEMO/MOCK mode (no real backend or auth).
#
# Find these in your Supabase dashboard:
#   Project Settings → API → "Project URL" and "anon / public" key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push (optional — enables notifications while the app is closed).
# Generate a key pair with:  npx web-push generate-vapid-keys
# Put the PUBLIC key here; the private key goes into the push-notify
# Edge Function secrets (see SUPABASE_SETUP.md → Web Push).
VITE_VAPID_PUBLIC_KEY=
